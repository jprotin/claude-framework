site_name: "Features — tous les projets"
docs_dir: "{{DOCS_PATH}}"
site_dir: "{{SITE_PATH}}"

theme:
  name: material
  language: fr
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Mode sombre
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Mode clair
  features:
    - navigation.tabs           # projets en onglets (1 tab = 1 projet)
    - navigation.tabs.sticky
    - navigation.sections       # features en sections dans la sidebar
    - navigation.expand
    - navigation.top            # bouton retour en haut
    - navigation.footer
    - search.suggest
    - search.highlight
    - search.share
    - toc.follow                # TOC suit le scroll
    - content.code.copy
    - content.tabs.link

hooks:
  - "{{HOOKS_PATH}}"           # tableau de bord, « En ce moment », kanban par projet

plugins:
  - search:
      lang: fr
      separator: '[\s\-\.]+'
  - awesome-pages

markdown_extensions:
  - admonition
  - pymdownx.details
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  - pymdownx.snippets
  - tables
  - attr_list
  - md_in_html
  - toc:
      permalink: true
      title: Sur cette page

extra_css:
  - assets/extra.css
